<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.WeightLoss" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/forest</item>
        <item name="colorOnPrimary">@color/on_forest</item>
        <item name="colorPrimaryContainer">@color/forest_soft</item>
        <item name="colorOnPrimaryContainer">@color/ink</item>

        <item name="colorSecondary">@color/clay</item>
        <item name="colorOnSecondary">@color/on_clay</item>
        <item name="colorSecondaryContainer">@color/clay_soft</item>
        <item name="colorOnSecondaryContainer">@color/ink</item>

        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorSurfaceVariant">@color/paper_deep</item>
        <item name="colorOnSurfaceVariant">@color/ink_soft</item>
        <item name="colorOutline">@color/line</item>
        <item name="colorOutlineVariant">@color/line</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="colorError">@color/clay</item>
        <item name="colorOnError">@color/on_clay</item>
        <item name="colorErrorContainer">@color/clay_soft</item>
        <item name="colorOnErrorContainer">@color/ink</item>

        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.WeightLoss.Dialog</item>
    </style>

    <style name="ThemeOverlay.WeightLoss.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.WeightLoss.Dialog</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorPrimary">@color/forest</item>
    </style>

    <style name="ShapeAppearance.WeightLoss.Dialog" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>

    <style name="TextAppearance.WeightLoss.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">58sp</item>
        <item name="android:letterSpacing">-0.04</item>
    </style>

    <style name="TextAppearance.WeightLoss.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">34sp</item>
        <item name="android:letterSpacing">-0.03</item>
    </style>

    <style name="TextAppearance.WeightLoss.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">23sp</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.WeightLoss.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="TextAppearance.WeightLoss.Overline" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ink_faint</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.18</item>
    </style>

    <style name="TextAppearance.WeightLoss.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/ink_soft</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextAppearance.WeightLoss.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="TextAppearance.WeightLoss.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/ink_soft</item>
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="TextAppearance.WeightLoss.Number" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="Widget.WeightLoss.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">6dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="backgroundTint">@color/forest</item>
        <item name="android:textColor">@color/on_forest</item>
        <item name="iconTint">@color/on_forest</item>
    </style>

    <style name="Widget.WeightLoss.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/forest</item>
        <item name="iconTint">@color/forest</item>
    </style>

    <style name="Widget.WeightLoss.Button.DangerText" parent="Widget.Material3.Button.TextButton">
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/clay</item>
    </style>

    <style name="Widget.WeightLoss.Button.Small" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">36dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/forest</item>
    </style>
</resources>
