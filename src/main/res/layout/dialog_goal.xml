<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="4dp"
    android:paddingEnd="24dp"
    android:paddingBottom="4dp">

    <TextView
        style="@style/TextAppearance.WeightLoss.BodySmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/goal_dialog_desc" />

    <TextView
        style="@style/TextAppearance.WeightLoss.Overline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/height_label" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etHeight"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:fontFamily="serif"
            android:imeOptions="actionNext"
            android:inputType="numberDecimal"
            android:maxLength="5"
            android:padding="0dp"
            android:textColor="@color/ink"
            android:textSize="22sp"
            tools:text="170" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginBottom="3dp"
            android:layout_gravity="bottom"
            android:text="@string/unit_cm"
            android:textColor="@color/ink_soft"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

    <TextView
        android:id="@+id/tvHeightError"
        style="@style/TextAppearance.WeightLoss.BodySmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/clay"
        android:visibility="gone"
        tools:text="请输入 100 到 250 之间的身高"
        tools:visibility="visible" />

    <TextView
        style="@style/TextAppearance.WeightLoss.Overline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="@string/target_weight_label" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etTarget"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:fontFamily="serif"
            android:imeOptions="actionDone"
            android:inputType="numberDecimal"
            android:maxLength="5"
            android:padding="0dp"
            android:textColor="@color/ink"
            android:textSize="22sp"
            tools:text="62.0" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginBottom="3dp"
            android:layout_gravity="bottom"
            android:text="@string/unit_kg"
            android:textColor="@color/ink_soft"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

    <TextView
        android:id="@+id/tvTargetError"
        style="@style/TextAppearance.WeightLoss.BodySmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/clay"
        android:visibility="gone"
        tools:text="请输入 20 到 300 之间的目标体重"
        tools:visibility="visible" />
</LinearLayout>
