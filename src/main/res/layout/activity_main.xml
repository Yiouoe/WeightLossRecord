<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:orientation="vertical">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:background="@color/paper"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/tabToday"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/cd_tab_today"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/labelToday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/tab_today"
                android:textColor="@color/forest"
                android:textSize="13sp" />

            <View
                android:id="@+id/indicatorToday"
                android:layout_width="16dp"
                android:layout_height="2dp"
                android:layout_marginTop="5dp"
                android:background="@color/forest" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabRecords"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/cd_tab_records"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/labelRecords"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="@string/tab_records"
                android:textColor="@color/ink_soft"
                android:textSize="13sp" />

            <View
                android:id="@+id/indicatorRecords"
                android:layout_width="16dp"
                android:layout_height="2dp"
                android:layout_marginTop="5dp"
                android:background="@color/forest"
                android:visibility="invisible" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/cd_tab_profile"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/labelProfile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="@string/tab_profile"
                android:textColor="@color/ink_soft"
                android:textSize="13sp" />

            <View
                android:id="@+id/indicatorProfile"
                android:layout_width="16dp"
                android:layout_height="2dp"
                android:layout_marginTop="5dp"
                android:background="@color/forest"
                android:visibility="invisible" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
